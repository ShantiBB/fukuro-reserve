### 14. Create hotel
POST {{baseUrl}}/api/v1/hotels
Authorization: Bearer {{ownerAccess}}
Content-Type: application/json

{
  "country_code": "jp",
  "city_slug": "tokyo",
  "title": "{{hotelTitle}}",
  "owner_id": 1,
  "description": "http client smoke hotel",
  "address": "1 HTTP Street, Tokyo",
  "location": {
    "latitude": 35.66,
    "longitude": 139.70
  }
}

> {%
  client.test("create hotel is 201", function () {
    client.assert(response.status === 201, "Expected 201");
  });
  client.global.set("hotelId", response.body.id);
  client.global.set("hotelSlug", response.body.hotel_slug);
%}

