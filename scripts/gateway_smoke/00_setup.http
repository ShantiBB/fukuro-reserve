### 04. Refresh owner token
POST {{baseUrl}}/api/v1/auth/refresh
Content-Type: application/json

{
  "refresh_token": "{{ownerRefresh}}"
}

> {%
  client.test("owner refresh is 200", function () {
    client.assert(response.status === 200, "Expected 200");
  });
%}

### 05. Resolve ownerId via admin users list
GET {{baseUrl}}/api/v1/auth/users?page=1&limit=100
Authorization: Bearer {{adminAccess}}

> {%
  client.test("users list for owner id lookup is 200", function () {
    client.assert(response.status === 200, "Expected 200");
  });

  const users = response.body.users || [];
  const ownerEmail = client.global.get("ownerEmail");
  const owner = users.find(function (u) {
    return u.email === ownerEmail;
  });
  client.assert(owner, "Owner was not found in users list");
  client.global.set("ownerId", String(owner.id));
%}
