### Setup shared test data and tokens
### Requires environment: local

### 00. Health + dynamic variables
GET {{baseUrl}}/health

> {%
  client.test("health is 200", function () {
    client.assert(response.status === 200, "Expected 200");
  });

  const ts = String(Math.floor(Date.now() / 1000));
  client.global.set("ts", ts);
  client.global.set("ownerEmail", "http-owner-" + ts + "@example.com");
  client.global.set("managedEmail", "http-managed-" + ts + "@example.com");
  client.global.set("ownerUsername", "http-owner-" + ts);
  client.global.set("managedUsername", "http-managed-" + ts);
  client.global.set("hotelTitle", "HTTP Smoke Hotel " + ts);
  client.global.set("hotelTitleRenamed", "HTTP Smoke Hotel Renamed " + ts);
%}

### 01. Register owner
POST {{baseUrl}}/api/v1/auth/register
Content-Type: application/json

{
  "email": "{{ownerEmail}}",
  "password": "{{password}}"
}

> {%
  client.test("register owner is 200", function () {
    client.assert(response.status === 200, "Expected 200");
  });
  client.global.set("ownerAccess", response.body.access);
  client.global.set("ownerRefresh", response.body.refresh);
%}

### 02. Login admin
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

> {%
  client.test("admin login is 200", function () {
    client.assert(response.status === 200, "Expected 200");
  });
  client.global.set("adminAccess", response.body.access);
%}

