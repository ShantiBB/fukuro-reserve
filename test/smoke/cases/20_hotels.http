### Hotel endpoints
### Requires: setup and auth files completed

### 20. Create hotel
POST {{baseUrl}}/api/v1/hotels
Authorization: Bearer {{ownerAccess}}
Content-Type: application/json

{
  "country_code": "jp",
  "city_slug": "tokyo",
  "title": "{{hotelTitle}}",
  "owner_id": 1,
  "description": "http client smoke hotel",
  "address": "1 HTTP Street, Tokyo",
  "location": {
    "latitude": 35.66,
    "longitude": 139.70
  }
}

> {%
  client.test("create hotel is 201", function () {
    client.assert(response.status === 201, "Expected 201");
  });
  client.global.set("hotelId", response.body.id);
  client.global.set("hotelSlug", response.body.hotel_slug);
%}

### 21. List hotels
GET {{baseUrl}}/api/v1/hotels?country_code=jp&city_slug=tokyo&sort_by=title&page=1&limit=10
Authorization: Bearer {{ownerAccess}}

> {%
  client.test("list hotels is 200", function () {
    client.assert(response.status === 200, "Expected 200");
  });
%}

### 22. Get hotel by slug
GET {{baseUrl}}/api/v1/hotels/jp/tokyo/{{hotelSlug}}
Authorization: Bearer {{ownerAccess}}

> {%
  client.test("get hotel is 200", function () {
    client.assert(response.status === 200, "Expected 200");
  });
%}

### 23. Update hotel
PUT {{baseUrl}}/api/v1/hotels/jp/tokyo/{{hotelSlug}}
Authorization: Bearer {{ownerAccess}}
Content-Type: application/json

{
  "description": "updated by http client",
  "address": "2 HTTP Street, Tokyo",
  "location": {
    "latitude": 35.67,
    "longitude": 139.71
  }
}

> {%
  client.test("update hotel is 200", function () {
    client.assert(response.status === 200, "Expected 200");
  });
%}

### 24. Rename hotel
PATCH {{baseUrl}}/api/v1/hotels/jp/tokyo/{{hotelSlug}}/title
Authorization: Bearer {{ownerAccess}}
Content-Type: application/json

{
  "title": "{{hotelTitleRenamed}}"
}

> {%
  client.test("rename hotel is 200", function () {
    client.assert(response.status === 200, "Expected 200");
  });
  const slugFromResponse = response.body.hotel_slug;
  if (slugFromResponse) {
    client.global.set("hotelSlug", slugFromResponse);
  } else {
    const title = client.global.get("hotelTitleRenamed").toLowerCase();
    const generatedSlug = title.replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "");
    client.global.set("hotelSlug", generatedSlug);
  }
%}

### 25. Get renamed hotel
GET {{baseUrl}}/api/v1/hotels/jp/tokyo/{{hotelSlug}}
Authorization: Bearer {{ownerAccess}}

> {%
  client.test("get renamed hotel is 200", function () {
    client.assert(response.status === 200, "Expected 200");
  });
%}
