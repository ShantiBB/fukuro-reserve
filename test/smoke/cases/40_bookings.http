### Booking endpoints
### Requires: rooms file completed

### 40. Create booking
POST {{baseUrl}}/api/v1/bookings
Authorization: Bearer {{ownerAccess}}
Content-Type: application/json

{
  "user_id": {{ownerId}},
  "hotel_id": "{{hotelId}}",
  "check_in": "2026-06-01T12:00:00Z",
  "check_out": "2026-06-03T12:00:00Z",
  "guest_name": "HTTP Booker",
  "guest_email": "{{ownerEmail}}",
  "guest_phone": "+79990000055",
  "currency": "USD",
  "expected_total_amount": "350.00",
  "rooms": [
    {
      "room_id": "{{roomId}}",
      "adults": 2,
      "children": 1,
      "price_per_night": "175.00"
    }
  ]
}

> {%
  client.test("create booking is 201", function () {
    client.assert(response.status === 201, "Expected 201");
  });
  client.global.set("bookingId", response.body.id);
%}

### 41. List bookings (all)
GET {{baseUrl}}/api/v1/bookings?page=1&limit=10
Authorization: Bearer {{ownerAccess}}

> {%
  client.test("list bookings all is 200", function () {
    client.assert(response.status === 200, "Expected 200");
  });
%}

### 42. List bookings by user
GET {{baseUrl}}/api/v1/bookings?userId={{ownerId}}&page=1&limit=10
Authorization: Bearer {{ownerAccess}}

> {%
  client.test("list bookings by user is 200", function () {
    client.assert(response.status === 200, "Expected 200");
  });
%}

### 43. List bookings by user and hotel
GET {{baseUrl}}/api/v1/bookings?userId={{ownerId}}&hotelId={{hotelId}}&page=1&limit=10
Authorization: Bearer {{ownerAccess}}

> {%
  client.test("list bookings by user+hotel is 200", function () {
    client.assert(response.status === 200, "Expected 200");
  });
%}

### 44. Get booking
GET {{baseUrl}}/api/v1/bookings/{{bookingId}}
Authorization: Bearer {{ownerAccess}}

> {%
  client.test("get booking is 200", function () {
    client.assert(response.status === 200, "Expected 200");
  });
%}

### 45. Confirm booking
PATCH {{baseUrl}}/api/v1/bookings/{{bookingId}}/confirm
Authorization: Bearer {{ownerAccess}}

> {%
  client.test("confirm booking is 200", function () {
    client.assert(response.status === 200, "Expected 200");
  });
%}

### 46. Cancel booking
PATCH {{baseUrl}}/api/v1/bookings/{{bookingId}}/cancel
Authorization: Bearer {{ownerAccess}}

> {%
  client.test("cancel booking is 200", function () {
    client.assert(response.status === 200, "Expected 200");
  });
%}
